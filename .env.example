# Copy this file to .env.local and fill it in. .env.local is ignored by git, so it never leaves your computer.

# The Gmail address that sends the enquiry emails
GMAIL_USER=you@gmail.com

# A 16-character Google App Password, NOT your normal Gmail password.
# Turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional: where enquiries are delivered (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=

# Optional: set to 1 to validate submissions without sending emails
CONTACT_DRY_RUN=
